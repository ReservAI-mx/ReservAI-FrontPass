# Runtime
NODE_ENV=development
# production | development (también se puede pasar como argv[3] a server.js)
STAGE=development

# Secreto compartido con reservAI_gateway (header X-Proxy-Secret).
# Obligatorio en production. Debe coincidir con el del gateway y del backend.
PROXY_SECRET_HEADER=change_me_proxy_secret
# PROXY_SECRET_HEADER_NAME=x-proxy-secret

# Solo desarrollo: destino del proxy /api si no usas el gateway
# API_PROXY_TARGET=http://127.0.0.1:3000
